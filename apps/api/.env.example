# Each environment (local/test/staging/production) MUST use its own
# DATABASE_URL pointing at a distinct database and its own credentials —
# never share a connection string or password across environments
# (spec FR-002/US1). `prisma migrate deploy` against this URL is safe to
# re-run: already-applied migrations are skipped as a no-op.
DATABASE_URL=postgresql://user:pass@localhost:5432/nuqaa_asir
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=nuqaa-asir-service-images
OBJECT_STORAGE_PUBLIC_URL=
CORS_ALLOWED_ORIGIN=http://localhost:5173
DEFAULT_LOCALE=ar-SA
DEFAULT_TIMEZONE=Asia/Riyadh
PORT=4000
